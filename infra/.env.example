# App
APP_ENV=local
API_BASE_URL=https://localhost
FRONTEND_BASE_URL=https://localhost
DEMO_OWNER_ID=00000000-0000-0000-0000-000000000001
AUTO_PROCESS_INLINE=false

# API keys
OPENAI_API_KEY=
COHERE_API_KEY=
OPENAI_USE_PROXY=false
PROXY_URL=

# AI models
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
COHERE_RERANK_MODEL=rerank-v3.5

# Mistral-compatible setup
# OPENAI_API_BASE=https://api.mistral.ai/v1
# OPENAI_EMB_API_BASE=https://api.mistral.ai/v1
# OPENAI_VISION_MODEL=mistral-small-latest
# OPENAI_TRANSCRIPTION_MODEL=voxtral-mini-latest
# OPENAI_EMBEDDING_MODEL=mistral-embed
# OPENAI_EMBEDDING_DIMENSIONS=1024
# QDRANT_COLLECTION=semantic_drive_chunks_mistral_1024

# Database / queue / vector store
DATABASE_URL=postgresql+psycopg://semantic:semantic@postgres:5432/semantic_drive
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=semantic-drive
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=semantic_drive_chunks

# MinIO local object storage
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=semantic
MINIO_SECRET_KEY=semantic-secret
MINIO_BUCKET=semantic-drive
MINIO_SECURE=false

# Files
MAX_UPLOAD_MB=512
TMP_DIR=/tmp/semantic-drive
ALLOWED_ORIGINS=["https://localhost","https://127.0.0.1","http://localhost:4321","http://127.0.0.1:4321"]
